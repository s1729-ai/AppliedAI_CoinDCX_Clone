# ==========================================
# CoinDCX Demo - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=coindcx_demo_jwt_secret_key_2026

# Database
# Optional: If MongoDB is running locally or on Atlas, provide the URI.
# If omitted or unavailable, the application automatically uses a resilient, persistent local store engine.
MONGODB_URI=mongodb://localhost:27017/coindcx_demo

# AI Microservice
PYTHON_AI_URL=http://localhost:8000

# Optional LLM API Keys (Gemini / OpenAI for live generative chat)
GEMINI_API_KEY=
OPENAI_API_KEY=
